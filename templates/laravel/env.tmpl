APP_NAME="{{ .AppName }}"
APP_ENV=production
APP_KEY={{ .AppKey }}
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL={{ .URL }}

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

{{ if eq .DBConnection "sqlite" -}}
DB_CONNECTION=sqlite
DB_DATABASE={{ .Directory }}/shared/database.sqlite
{{- else -}}
DB_CONNECTION={{ .DBConnection }}
DB_HOST=127.0.0.1
DB_PORT={{ .DBPort }}
DB_DATABASE={{ .DBName }}
DB_USERNAME={{ .DBUser }}
DB_PASSWORD={{ .DBPassword }}
{{- end }}

SESSION_DRIVER={{ if .Redis }}redis{{ else }}file{{ end }}
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE={{ .SSL }}

CACHE_STORE={{ if .Redis }}redis{{ else }}file{{ end }}
CACHE_DRIVER={{ if .Redis }}redis{{ else }}file{{ end }}
CACHE_PREFIX={{ .ID }}_cache_
QUEUE_CONNECTION={{ if .Redis }}redis{{ else }}database{{ end }}
BROADCAST_CONNECTION={{ if .Reverb }}reverb{{ else }}log{{ end }}
BROADCAST_DRIVER={{ if .Reverb }}reverb{{ else }}log{{ end }}
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX={{ .ID }}_

MAIL_MAILER=log
{{- if .Reverb }}

REVERB_APP_ID={{ .ReverbAppID }}
REVERB_APP_KEY={{ .ReverbKey }}
REVERB_APP_SECRET={{ .ReverbSecret }}
REVERB_HOST={{ .Domain }}
REVERB_PORT={{ if .SSL }}443{{ else }}80{{ end }}
REVERB_SCHEME={{ if .SSL }}https{{ else }}http{{ end }}
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT={{ .ReverbPort }}
{{- end }}
